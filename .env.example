# ============================================================
# Claude AI Investment Simulator - Environment Configuration
# ============================================================

# --- Anthropic API ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-opus-4-8

# --- Supabase / PostgreSQL ---
#
# [必須] SQLAlchemy直接接続用 - これだけでDBは動作する
# Supabase Dashboard > Settings > Database > Connection string (URI) から取得
#
# Session mode (port 5432) - 通常の接続
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# Transaction mode (port 6543) - 多数の同時接続がある場合
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# [任意] Supabase Client SDK用 - Storage/Auth/Realtime を使う場合のみ
# Supabase Dashboard > Settings > API から取得
# 現在の実装では未使用 (将来の拡張用)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_KEY=

# --- CoinGecko (optional - free tier available) ---
COINGECKO_API_KEY=

# --- Trading Parameters ---
INITIAL_CAPITAL_JPY=100000.0
MAX_POSITION_PCT=0.20
MAX_POSITIONS=5
TRANSACTION_FEE_PCT=0.001

# --- Agent Configuration ---
AGENT_NAME=Claude Investment Agent
AGENT_DESCRIPTION=Claude-powered virtual investment fund manager

# --- Scheduler ---
TIMEZONE=Asia/Tokyo

# --- Logging ---
LOG_LEVEL=INFO
