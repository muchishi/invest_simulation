# ============================================================
# AI Investment Simulator - Environment Configuration
# ============================================================

# ── AI Provider ──────────────────────────────────────────────
# "claude" または "groq" を選択
AI_PROVIDER=groq

# ── Groq (AI_PROVIDER=groq の場合) - 完全無料枠で運用可能 ──
# APIキー取得: https://console.groq.com/keys (クレカ不要)
# 無料枠: 30req/分, 6,000req/日  本システムは月65回なので十分
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# モデル選択:
#   llama-3.3-70b-versatile  最高品質・推奨
#   llama-3.1-70b-versatile  高品質
#   llama-3.1-8b-instant     高速・軽量
GROQ_MODEL=llama-3.3-70b-versatile

# ── Anthropic Claude (AI_PROVIDER=claude の場合) - 有料・高品質 ──
# claude-opus-4-8:   最高精度 ($15/$75/MTok) 月額約¥450
# claude-sonnet-4-6: バランス ($3/$15/MTok)  月額約¥90
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-opus-4-8

# ── Supabase / PostgreSQL ─────────────────────────────────────
# [必須] SQLAlchemy直接接続用 - DATABASE_URL だけでDB機能は全て動作する
# 取得先: Supabase Dashboard > Settings > Database > Connection string (URI)
#
# Session mode (port 5432) - 長時間稼働プロセス向け・推奨
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# Transaction mode (port 6543) - 短命接続・serverless向け
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# [任意] Supabase Client SDK用 - Storage/Auth/Realtime を使う場合のみ
# 現在の実装では未使用 (将来の拡張用)
# 取得先: Supabase Dashboard > Settings > API
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_KEY=

# ── Market Data ───────────────────────────────────────────────
# CoinGecko (任意 - 無料枠で利用可能)
COINGECKO_API_KEY=

# ── Trading Parameters ────────────────────────────────────────
INITIAL_CAPITAL_JPY=100000.0
MAX_POSITION_PCT=0.20
MAX_POSITIONS=5
TRANSACTION_FEE_PCT=0.001

# ── Agent ─────────────────────────────────────────────────────
AGENT_NAME=AI Investment Agent
AGENT_DESCRIPTION=AI-powered virtual investment fund manager

# ── Scheduler ─────────────────────────────────────────────────
TIMEZONE=Asia/Tokyo
LOG_LEVEL=INFO
