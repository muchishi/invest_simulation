# ============================================================
# Claude AI Investment Simulator - Environment Configuration
# ============================================================

# --- Anthropic API ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-opus-4-8

# --- Supabase / PostgreSQL ---
# Supabase Direct Connection
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Or Transaction Pooler (recommended for serverless)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- CoinGecko (optional - free tier available) ---
COINGECKO_API_KEY=

# --- Trading Parameters ---
INITIAL_CAPITAL_JPY=100000.0
MAX_POSITION_PCT=0.20
MAX_POSITIONS=5
TRANSACTION_FEE_PCT=0.001

# --- Agent Configuration ---
AGENT_NAME=Claude Investment Agent
AGENT_DESCRIPTION=Claude-powered virtual investment fund manager

# --- Scheduler ---
TIMEZONE=Asia/Tokyo

# --- Logging ---
LOG_LEVEL=INFO
